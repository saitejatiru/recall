#!/bin/sh
# Reject commits containing NVIDIA API key-format strings (40+ chars after nvapi-)
# Using extended regex to avoid false positives on prose that mentions "nvapi-" prefix
if git diff --cached -U0 | grep -qE 'nvapi-[A-Za-z0-9_-]{40,}'; then
  echo "ERROR: NVIDIA API key detected in staged files. Remove before committing."
  exit 1
fi
